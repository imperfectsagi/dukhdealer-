{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dukh-dealer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dukh-dealer-db",
      "database_id": "d60f4ad2-0a76-4883-8a01-fb27f0a9390b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "dukh-dealer-media"
    }
  ]
}
